# Church CMS — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Database -----------------------------------------------------------------
# Postgres connection string. App connects as a NON-superuser so Row-Level
# Security policies are enforced (superusers bypass RLS).
DATABASE_URL="postgresql://cms_app:cms_dev_pw@localhost:5432/church_cms?schema=public"

# --- Auth (Auth.js v5) --------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Base URL of the running app
AUTH_URL="http://localhost:3000"

# --- Stripe (giving + SaaS billing) ------------------------------------------
# Use test-mode keys during development. Webhooks verified by signature.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="no-reply@example.com"

# --- SMS (Twilio) ------------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
